# Your Nightscout site. No trailing slash.
NS_URL=https://your-nightscout.example.com

# A Nightscout ACCESS TOKEN, not the admin API_SECRET.
#
# Create one in Nightscout under Admin Tools -> Subjects: add a subject with
# the "readable" role only. The token looks like `claude-1a2b3c4d5e6f7890`.
# Using API_SECRET here would hand this server write access to your data for
# no benefit — nothing in it writes.
NS_TOKEN=readonly-subject-token

# The bearer callers must present. REQUIRED — the server refuses to start
# without it. Generate a long random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_BEARER=generate-a-long-random-string

# Optional.
PORT=8787
NS_UNITS=mg/dl          # or: mmol

# Only set this if a reverse proxy in front of you sets X-Forwarded-*.
# Comma-separated IPs, or "*" to trust any caller's forwarded headers —
# "*" is only safe when nothing but your proxy can reach the port.
# TRUSTED_PROXY_IPS=172.18.0.0/16
